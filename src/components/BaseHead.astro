---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { DEFAULT_SHARE_IMAGE, SITE_NAME } from '../consts';

interface Props {
	title: string;
	description: string;
	/** Ask search engines not to index the page, and omit the canonical URL */
	noindex?: boolean;
	/** Link preview image, a path in public/. Defaults to DEFAULT_SHARE_IMAGE */
	image?: { src: string; alt: string };
	/** OpenGraph type: 'article' for blog posts */
	type?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	noindex = false,
	image = DEFAULT_SHARE_IMAGE,
	type = 'website',
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- OpenGraph link previews -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonicalURL} />}
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}
{image && <meta property="og:image:alt" content={image.alt} />}
