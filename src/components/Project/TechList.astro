---
interface Props {
	tech: string[];
}

const { tech } = Astro.props;
---

{tech.length > 0 && (
	<ul>
		{tech.map((name) => (
			<li>{name}</li>
		))}
	</ul>
)}

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		padding: 0.15em 0.6em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
	}
</style>
