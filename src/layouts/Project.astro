---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import ProjectDates from '../components/Project/ProjectDates.astro';
import TechList from '../components/Project/TechList.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, startDate, endDate, role, tech, repoUrl, liveUrl, heroImage } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage ? { src: heroImage, alt: title } : undefined}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
			}
			.title h1 {
				margin: 0 0 0.25em 0;
				line-height: 1;
			}
			.meta {
				margin: 0 0 1em 0;
				color: rgb(var(--gray));
			}
			.tech {
				display: flex;
				justify-content: center;
				margin-bottom: 1em;
			}
			.links {
				display: flex;
				justify-content: center;
				gap: 1.5em;
				margin: 0 0 1em 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<p class="meta">
							<ProjectDates startDate={startDate} endDate={endDate} />
							{role && <> · {role}</>}
						</p>
						<div class="tech">
							<TechList tech={tech} />
						</div>
						{(liveUrl || repoUrl) && (
							<p class="links">
								{liveUrl && <a href={liveUrl}>Visit site</a>}
								{repoUrl && <a href={repoUrl}>Source code</a>}
							</p>
						)}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
